{
  "name": "galadon",
  "version": "0.3.1",
  "description": "A five-stage engineering loop for agent-built projects: spec, build, verify, ship, learn, with a layout/stack scaffold generator. Pluggable role, template and deploy ports.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/test_plugin.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/galadon",
    "assets/",
    "src/galadon/**/*.py",
    "skills/galadon/",
    "templates/",
    "examples/",
    "schema/",
    "index.js",
    "cordis.patch.yml",
    ".codex-plugin/plugin.json",
    ".zcode-plugin/plugin.json",
    ".release-gate.json",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.6 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumos-789/galadon"
  },
  "keywords": [
    "dsh-plugin",
    "agent",
    "workflow",
    "scaffold",
    "deploy"
  ]
}
